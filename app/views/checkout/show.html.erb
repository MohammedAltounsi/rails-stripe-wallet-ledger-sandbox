<% content_for :title, "Checkout · Dallah" %>
<% enough = @balance_cents >= @total_cents %>

<section class="max-w-4xl mx-auto px-6 pt-16">
  <p class="label mb-3">Checkout</p>
  <h1 class="font-display text-4xl sm:text-5xl mb-10">Pickup &amp; payment</h1>

  <%= form_with url: checkout_path, method: :post, data: { turbo: false }, class: "grid lg:grid-cols-5 gap-6" do %>
    <!-- Summary -->
    <div class="lg:col-span-2 card rounded-2xl p-6 rise h-fit">
      <p class="label mb-4">Your order</p>
      <div class="space-y-4">
        <% @line_items.each do |li| %>
          <div class="flex items-start justify-between gap-3 text-sm">
            <span class="text-cream/80"><%= li[:qty] %> × <%= li[:product].name %><br><span class="text-cream/40 text-xs"><%= Customization.summary(li[:opts]) %></span></span>
            <span class="tnum text-cream/60 shrink-0"><%= money(li[:subtotal_cents]) %></span>
          </div>
        <% end %>
      </div>
      <div class="flex items-center justify-between mt-5 pt-4 border-t hairline">
        <span class="label">Total</span>
        <span class="font-display text-2xl text-gold tnum"><%= money(@total_cents) %></span>
      </div>
    </div>

    <!-- Pickup + payment -->
    <div class="lg:col-span-3 space-y-5">
      <div class="card rounded-2xl p-6 rise" style="animation-delay:.06s">
        <p class="label mb-4">Pick up at</p>
        <select name="pickup_store" class="w-full rounded-xl border hairline bg-transparent px-4 py-3 text-sm focus:border-gold outline-none">
          <% @stores.each { |s| %><option value="<%= s %>" class="bg-espresso-2"><%= s %></option><% } %>
        </select>
        <p class="label mb-4 mt-6">When</p>
        <select name="pickup_time" class="w-full rounded-xl border hairline bg-transparent px-4 py-3 text-sm focus:border-gold outline-none">
          <% ["As soon as possible", "In 15 minutes", "In 30 minutes", "In 1 hour"].each { |t| %><option value="<%= t %>" class="bg-espresso-2"><%= t %></option><% } %>
        </select>

        <p class="label mb-4 mt-6">Receipt email</p>
        <input type="email" name="email" required value="<%= current_customer.email %>"
               placeholder="you@example.com" autocomplete="email"
               class="w-full rounded-xl border hairline bg-transparent px-4 py-3 text-sm focus:border-gold outline-none">
        <p class="text-xs text-cream/40 mt-2">We’ll email your receipt here the moment payment clears.</p>
      </div>

      <div class="card rounded-2xl p-6 rise space-y-4" style="animation-delay:.12s">
        <p class="label">Pay with</p>

        <!-- Dallah Card (wallet) -->
        <div class="rounded-xl border hairline p-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="font-display text-lg">Dallah Card</p>
              <p class="text-sm text-cream/50">Balance <span class="tnum text-gold"><%= money(@balance_cents) %></span></p>
            </div>
            <span class="text-2xl">💳</span>
          </div>
          <% if enough %>
            <button name="pay" value="wallet" class="btn-gold w-full rounded-xl py-3.5 mt-4 text-sm">Pay <%= money(@total_cents) %> with Dallah Card</button>
          <% else %>
            <p class="text-sm text-red-600/90 mt-3">Short by <%= money(@total_cents - @balance_cents) %>.</p>
            <%= link_to "Reload Dallah Card →", wallet_path, class: "btn-ghost inline-flex w-full justify-center rounded-xl py-3.5 mt-2 text-sm" %>
          <% end %>
        </div>

        <!-- Card -->
        <div class="rounded-xl border hairline p-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="font-display text-lg">Credit or debit card</p>
              <p class="text-sm text-cream/50">Visa, Mastercard, mada, via Stripe</p>
            </div>
            <span class="text-2xl">🔒</span>
          </div>
          <button name="pay" value="card" class="btn-ghost w-full rounded-xl py-3.5 mt-4 text-sm hover:border-gold">Pay by card →</button>
        </div>
      </div>
    </div>
  <% end %>
</section>
