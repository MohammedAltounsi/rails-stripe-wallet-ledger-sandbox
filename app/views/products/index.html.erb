<% content_for :title, "Order — Dallah Coffee" %>

<!-- Hero -->
<section class="max-w-6xl mx-auto px-6 pt-12 pb-6">
  <div class="grid lg:grid-cols-2 gap-10 items-center">
    <div class="rise">
      <p class="label mb-4">Jeddah · order ahead</p>
      <h1 class="font-display text-5xl sm:text-6xl leading-[0.95] tracking-tight">
        Order ahead.<br><span class="text-gold italic">Skip the line.</span>
      </h1>
      <p class="mt-5 max-w-md text-cream/60 leading-relaxed">
        Build your drink, pay with your Dallah Card or by card, and pick it up ready — hot off Tahlia, the Corniche, or Al Rawdah.
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-4">
        <a href="#hot-coffee" class="btn-gold rounded-full px-6 py-3 text-sm">See the menu</a>
        <div class="inline-flex items-center gap-4 rounded-full border hairline px-4 py-2.5">
          <span class="label">Dallah Card</span>
          <span class="font-display text-xl text-gold tnum"><%= money(current_customer.wallet_balance_cents) %></span>
          <%= link_to "Reload", wallet_path, class: "text-sm text-cream/70 hover:text-gold transition-colors" %>
        </div>
      </div>
    </div>

    <div class="rise" style="animation-delay:.1s">
      <div class="relative rounded-3xl overflow-hidden aspect-[4/5] sm:aspect-[16/11] lg:aspect-[4/5]">
        <img src="https://images.pexels.com/photos/312418/pexels-photo-312418.jpeg?auto=compress&cs=tinysrgb&w=1200"
             alt="A latte with rosetta art in a black cup"
             class="absolute inset-0 h-full w-full object-cover"
             onerror="this.closest('.rise').style.display='none'">
        <div class="absolute inset-0 bg-gradient-to-t from-espresso via-transparent to-transparent"></div>
        <div class="absolute bottom-5 left-5 right-5 flex items-end justify-between">
          <div>
            <p class="label text-cream/70">Barista's pick</p>
            <p class="font-display text-2xl">Rosetta Flat White</p>
          </div>
          <span class="text-xs rounded-full border border-cream/25 bg-espresso/60 backdrop-blur px-3 py-1.5">Freshly pulled</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Sticky category nav -->
<nav class="sticky top-20 z-20 backdrop-blur-md bg-espresso/85 border-y hairline">
  <div class="max-w-6xl mx-auto px-6 flex gap-2 overflow-x-auto py-3">
    <% @sections.each do |category, _| %>
      <a href="#<%= category.parameterize %>" class="whitespace-nowrap text-sm rounded-full border hairline px-4 py-2 text-cream/70 hover:text-gold hover:border-gold/50 transition-colors"><%= category %></a>
    <% end %>
  </div>
</nav>

<!-- Menu sections -->
<div class="max-w-6xl mx-auto px-6 pb-8">
  <% @sections.each do |category, products| %>
    <section id="<%= category.parameterize %>" class="scroll-mt-40 pt-12">
      <div class="flex items-center gap-4 mb-6">
        <h2 class="font-display text-3xl"><%= category %></h2>
        <span class="h-px flex-1 bg-gradient-to-r from-gold/40 to-transparent"></span>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% products.each_with_index do |product, i| %>
          <%= link_to product_path(product), class: "card rounded-2xl overflow-hidden rise group flex flex-col", style: "animation-delay:#{(0.04*i).round(2)}s" do %>
            <%= product_media(product, klass: "aspect-[4/3] w-full transition-transform duration-500 group-hover:scale-[1.03]", iced: product.temperature == "iced") %>
            <div class="p-5 flex flex-col flex-1">
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <h3 class="font-display text-xl leading-tight group-hover:text-gold transition-colors"><%= product.name %></h3>
                  <p class="text-gold text-xs mt-1"><%= product.tagline %></p>
                </div>
                <span class="shrink-0 text-sm tnum text-cream/80 rounded-full border hairline px-3 py-1">from <%= money(product.price_cents) %></span>
              </div>
              <p class="text-cream/55 text-sm mt-3 leading-snug"><%= product.description %></p>
              <span class="mt-4 pt-4 border-t hairline text-sm text-gold inline-flex items-center gap-1.5 mt-auto">
                Customize &amp; add
                <svg class="h-4 w-4 group-hover:translate-x-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M5 12h14m-6-6 6 6-6 6"/></svg>
              </span>
            </div>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
