<% content_for :title, "Orders · Dallah" %>

<section class="max-w-3xl mx-auto px-6 pt-16">
  <p class="label mb-3">History</p>
  <h1 class="font-display text-4xl sm:text-5xl mb-10"><%= current_customer.name %>’s orders</h1>

  <% if @orders.empty? %>
    <div class="card rounded-2xl p-12 text-center rise">
      <p class="text-cream/60 text-lg">No orders yet.</p>
      <%= link_to "Browse the menu →", root_path, class: "btn-gold inline-flex mt-6 rounded-full px-6 py-3 text-sm" %>
    </div>
  <% else %>
    <div class="card rounded-2xl divide-y divide-cream/10 rise">
      <% @orders.each do |order| %>
        <%= link_to order_path(order), class: "flex items-center justify-between p-5 hover:bg-gold/5 transition-colors" do %>
          <div class="min-w-0">
            <p class="font-display text-lg leading-tight"><%= order.reference %></p>
            <p class="text-xs text-cream/40 mt-0.5">
              <%= pluralize(order.order_items.sum(&:quantity), "item") %> · <%= order.payment_method %> · <%= order.created_at.strftime("%-d %b, %H:%M") %>
            </p>
          </div>
          <div class="flex items-center gap-4">
            <span class="text-xs rounded-full border hairline px-2.5 py-1 <%= order.paid? ? 'text-gold border-gold/40' : (order.pending? ? 'text-cream/50' : 'text-red-600') %>"><%= order.status %></span>
            <span class="font-display text-lg tnum"><%= money(order.total_cents) %></span>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>
